# =============================================================================
# Auth System - Environment Variables (Docker-ready)
# =============================================================================

# --- Flask Core ---
FLASK_CONFIG=production
SECRET_KEY=*****
JWT_SECRET_KEY=*****

# --- Database for HOST development ---
# Используется только если запускаете НЕ в Docker
DATABASE_URL=postgresql://cubinez85:******@localhost:5432/auth_system_db

# === Redis Settings ===
# URL для подключения к Redis внутри Docker-сети
REDIS_URL=redis://redis:6379/0

# Flask-Limiter будет использовать эту переменную
RATELIMIT_STORAGE_URL=redis://redis:6379/0

# Опционально: пароль для Redis (если включите requirepass)
REDIS_PASSWORD=******

# --- Database for Docker Compose ---
# Эти переменные используются docker-compose.yml
# DATABASE_URL будет переопределён в compose для подключения к контейнеру
DB_USER=auth_user
DB_PASSWORD=******
DB_NAME=auth_system
DB_HOST=postgres          # ← Имя сервиса в docker-compose.yml
DB_PORT=5432

# --- JWT ---
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# --- Admin ---
ADMIN_EMAIL=cubinez85@cubinez.ru
ADMIN_PASSWORD=*****

# --- Security ---
CORS_ORIGINS=http://localhost,http://localhost:8084,https://auth.cubinez.ru

# --- Rate Limiting ---
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100/hour
RATELIMIT_STORAGE_URL=memory://

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=true          # На хосте: писать в файл
RUNNING_IN_DOCKER=false   # В docker-compose.yml установить: true

# --- Email (External SMTP Server - NO CHANGES) ---
MAIL_SERVER=95.174.94.246
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=cubinez85@cubinez.ru
MAIL_PASSWORD=Wy8ymr74LwCqhua
MAIL_DEFAULT_SENDER=cubinez85@cubinez.ru

# --- Email Verification ---
EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_VERIFICATION_MIN_INTERVAL_MINUTES=5

# --- Password Reset ---
PASSWORD_RESET_EXPIRES_HOURS=1
PASSWORD_RESET_MIN_INTERVAL_MINUTES=15

# --- Base URL ---
BASE_URL=http://localhost:8084

# --- Development Flags ---
MAIL_LOG_ONLY=false
FLASK_CONFIG=production
